{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Wrapper",
  "version": "0.1.0",
  "identifier": "com.yafi.hermeswrapper",
  "build": {
    "beforeDevCommand": "echo noop",
    "devUrl": "http://127.0.0.1:9119",
    "beforeBuildCommand": "echo noop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hermes Wrapper",
        "url": "http://127.0.0.1:9119",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}